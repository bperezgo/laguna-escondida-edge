# laguna-escondida edge node — environment configuration TEMPLATE.
#
# Copy this file to  env\edge-node.env  and fill in the real values.
# scripts\install.ps1 copies  env\edge-node.env  ->  artifacts\edge-node\.env ,
# which the backend loads on startup (cmd/main.go: godotenv.Load()).
#
# This .example IS committed; env\edge-node.env is GITIGNORED. Never commit real secrets.
# Vars marked (required) cause the process to refuse to start if unset.

# --- Process -------------------------------------------------------------------
PORT=8080                 # (required) HTTP listen port; Caddy/Next reach it on 127.0.0.1:8080
APP_MODE=edge             # cloud | edge — this box runs in edge mode

# --- Database (local Postgres on this box) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=laguna
DB_PASSWORD=CHANGE_ME
DB_NAME=laguna_escondida
DB_SSLMODE=disable

# --- Identity / auth (must match the cloud where relevant) ---------------------
ORGANIZATION_ID=          # (required)
JWT_SECRET=CHANGE_ME      # (required)
ADMIN_API_KEY=CHANGE_ME   # (required)

# --- Cloud sync (edge -> cloud) ------------------------------------------------
# Leave CLOUD_SYNC_URL / NODE_SYNC_KEY blank to disable sync (box runs local-only).
CLOUD_SYNC_URL=
NODE_SYNC_KEY=
# CLOUD_NODE_ID=          # defaults to a value derived from ORGANIZATION_ID
# NODE_ID=               # defaults to derived from organization + mode
# SYNC_PUSH_CRON=* * * * *
# SYNC_PULL_CRON=* * * * *

# --- Object storage (cloud S3 / DigitalOcean Spaces) ---------------------------
SPACES_REGION=https://nyc3.digitaloceanspaces.com   # (required) region endpoint, WITH https://
SPACES_KEY=               # (required)
SPACES_SECRET=            # (required)
SPACES_BUCKET=            # (required)
# SPACES_ENDPOINT=        # override for non-DigitalOcean / local MinIO

# --- Electronic invoicing (online provider) ------------------------------------
ELECTRONIC_INVOICE_URL=          # (required)
ELECTRONIC_INVOICE_USER=         # (required)
ELECTRONIC_INVOICE_PASSWORD=     # (required)
# ELECTRONIC_INVOICE_PREFIX=SETP
# SUPPORT_DOCUMENT_PREFIX=SETP

# --- Printing (built into this binary; edge mode) ------------------------------
PRINTER_TRANSPORT=windows        # file | windows | network
PRINTER_TARGET=                  # windows: printer name | network: ip:port | file: path
# PRINTER_WIDTH_MM=80
# PRINTER_CODEPAGE=CP850
# PRINTER_CUT=partial            # full | partial

# --- Ticket content ------------------------------------------------------------
# BUSINESS_NAME=
# BUSINESS_NIT=
# BUSINESS_ADDRESS=
# TICKET_FOOTER=
# TICKET_LEGAL_NOTICE=
