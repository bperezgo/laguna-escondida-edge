# laguna-escondida edge node — environment configuration TEMPLATE.
#
# Copy this file to  env\edge-node.env  and fill in the real values.
# scripts\install.ps1 copies  env\edge-node.env  ->  artifacts\edge-node\.env ,
# which the backend loads on startup (cmd/main.go: godotenv.Load()).
#
# This .example IS committed; env\edge-node.env is GITIGNORED. Never commit real secrets.
# Vars marked (required) cause the process to refuse to start if unset.

# --- Process -------------------------------------------------------------------
PORT=8080                 # (required) HTTP listen port; Caddy/Next reach it on 127.0.0.1:8080
APP_MODE=edge             # cloud | edge — this box runs in edge mode

# --- Database (local Postgres on this box) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=laguna
DB_PASSWORD=CHANGE_ME
DB_NAME=laguna_escondida
DB_SSLMODE=disable

# --- Identity / auth (must match the cloud where relevant) ---------------------
ORGANIZATION_ID=          # (required)
JWT_SECRET=CHANGE_ME      # (required)
ADMIN_API_KEY=CHANGE_ME   # (required)

# --- Owner-triggered updates ----------------------------------------------------
# State dir shared with scripts\updater.ps1 (docs\UPDATE_PROTOCOL.md). Blank turns the
# "Actualizar" banner off.
LAGUNA_STATE_DIR=C:\laguna-edge\state

# --- Cloud sync (edge -> cloud) ------------------------------------------------
# Both are REQUIRED in edge mode: edge-node exits at startup when either is blank. The box
# still serves the LAN fully when the cloud is unreachable; it just queues sync until it is back.
CLOUD_SYNC_URL=           # (required) cloud backend base URL
NODE_SYNC_KEY=            # (required) this box's node key (same as LAGUNA_NODE_KEY in alloy.env)
# CLOUD_NODE_ID=          # defaults to a value derived from ORGANIZATION_ID
# NODE_ID=               # defaults to derived from organization + mode.
#                        # REQUIRED (uncommented, with a stable per-box value) when the
#                        # telemetry sidecar is enabled: the derived default is computed
#                        # inside the app and Alloy cannot reproduce it, so metrics would
#                        # never line up with logs. Must equal LAGUNA_NODE_ID in
#                        # env\alloy.env; install.ps1 refuses the install otherwise.
# SYNC_PUSH_CRON=* * * * *
# SYNC_PULL_CRON=* * * * *

# --- Object storage (AWS S3) ---------------------------------------------------
STORAGE_BUCKET=           # (required)
STORAGE_REGION=us-east-1  # AWS region of the bucket (default us-east-1)
STORAGE_ACCESS_KEY=       # optional: unset => AWS default credential chain
STORAGE_SECRET=
# STORAGE_ENDPOINT=       # override for a local MinIO (e.g. http://localhost:9000)
# CDN_URL=                # CloudFront base URL for public object URLs (optional)

# --- Electronic invoicing (online provider) ------------------------------------
ELECTRONIC_INVOICE_URL=          # (required)
ELECTRONIC_INVOICE_USER=         # (required)
ELECTRONIC_INVOICE_PASSWORD=     # (required)
# ELECTRONIC_INVOICE_PREFIX=SETP
# SUPPORT_DOCUMENT_PREFIX=SETP

# --- Printing (built into this binary; edge mode) ------------------------------
PRINTER_TRANSPORT=windows        # file | windows | network
PRINTER_TARGET=                  # windows: printer name | network: ip:port | file: path
# PRINTER_WIDTH_MM=80
# PRINTER_CODEPAGE=CP850
# PRINTER_CUT=partial            # full | partial

# --- Telemetry (logs/traces/metrics -> local Alloy sidecar -> cloud) -----------
# Leave OBSERVABILITY_ENABLED unset/false to ship nothing: the exporters no-op and the
# app is unaffected. That is also the rollback switch if the sidecar misbehaves.
#
# The endpoint is the LOCAL sidecar, never Grafana Cloud. This box holds no Grafana
# Cloud credentials; the cloud ingest owns them. See env\alloy.env.example.
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# METRICS_PORT=9090                 # Prometheus /metrics; Alloy scrapes this
# OTEL_SERVICE_NAME=laguna-backend  # must match LAGUNA_SERVICE_NAME in env\alloy.env
# ENVIRONMENT=production

# Volume lever: fraction of traces sampled. Keep BELOW 1.0 on the edge — a till at
# full sample is the easiest way to fill the disk buffer and the Grafana Cloud bill.
# Errors are still logged regardless of whether their trace was sampled.
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Ticket content ------------------------------------------------------------
# BUSINESS_NAME=
# BUSINESS_NIT=
# BUSINESS_ADDRESS=
# TICKET_FOOTER=
# TICKET_LEGAL_NOTICE=
