# laguna-escondida edge — FRONTEND (Next.js) BUILD-TIME environment TEMPLATE.
#
# Copy this file to  env\next.env  and set the real values for THIS box.
# scripts\build-artifacts.ps1 reads  env\next.env  and exports each key as an env var
# for `pnpm build`, so every NEXT_PUBLIC_* value is INLINED into the client bundle the
# tablet downloads.
#
# WHY here and not services\next.xml: Next inlines NEXT_PUBLIC_* at BUILD time. A value set
# only in next.xml (runtime) never reaches the browser bundle — it must be present during the
# build. (next.xml keeps NEXT_PUBLIC_API_URL only because THAT one is read server-side.)
#
# Adding another NEXT_PUBLIC_* later: just add the line here — build-artifacts.ps1 applies
# every key verbatim, so no PowerShell change is needed.
#
# Re-run after changing a value:  scripts\update.ps1 -Service next   (rebuilds Next).
#
# This .example IS committed; env\next.env is GITIGNORED (see /env/*.env in .gitignore).
#
# SECURITY NOTE: NEXT_PUBLIC_* is inlined in PLAINTEXT into JS the browser can read (visible in
# devtools). It is fine as a low-stakes UI gate, but is NOT a server-enforced secret — do not
# rely on it for real authorization.

# PIN the tablet requires to authorize order actions (e.g. void / discount / reprint).
NEXT_PUBLIC_ORDER_ACTION_PIN=0000

# NOTE: NEXT_PUBLIC_API_URL is intentionally NOT set here. build-artifacts.ps1 supplies it via
# its -BackendApiUrl parameter (default http://127.0.0.1:8080/api) because it is read
# server-side to reach the local Go backend. Setting it here too would just duplicate that.
