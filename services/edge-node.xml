<service>
  <id>laguna-edge-node</id>
  <name>Laguna Escondida - Edge Node (API)</name>
  <description>Go backend API in edge mode. Bound to 127.0.0.1:8080. Talks to local Postgres, syncs to the cloud, and drives ticket printing. Migrations are embedded in the binary and auto-run on startup.</description>

  <executable>%BASE%\..\artifacts\edge-node\edge-node.exe</executable>

  <!-- The binary loads its config from a .env file in its WORKING DIRECTORY
       (cmd/main.go: godotenv.Load()). scripts\install.ps1 copies
       env\edge-node.env -> artifacts\edge-node\.env, so set the working dir here.
       All app config (ports, DB, secrets, sync, printer) lives in that .env —
       see env\edge-node.env.example. We deliberately keep NO <env> here so there
       is a single source of truth and no secrets in committed XML. -->
  <workingdirectory>%BASE%\..\artifacts\edge-node</workingdirectory>

  <!-- Boot order: must start after Postgres. -->
  <depend>laguna-postgres</depend>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <stoptimeout>30 sec</stoptimeout>

  <logpath>%BASE%\..\logs</logpath>
  <!--
    STDOUT POLICY. The app logs to stdout unconditionally (a JSON slog handler) AND,
    when OBSERVABILITY_ENABLED=true, to the sidecar over OTLP. On a headless box
    nobody reads stdout day to day, so the cloud copy is the real one and this is a
    small on-box tail for when the box is offline or the sidecar is down.

    Capped, not discarded: 4 files x 5 MB per stream = 20 MB for stdout and 20 MB for
    stderr, so the pair can never exceed 40 MB no matter how long the service runs.
    WinSW deletes the oldest file past keepFiles, which is what makes the bound hold
    rather than merely slowing the growth.
  -->
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
</service>
