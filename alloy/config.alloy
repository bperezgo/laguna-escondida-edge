// =============================================================================
// Laguna Escondida edge -- telemetry sidecar (Grafana Alloy)
// =============================================================================
//
// The box is offline for long stretches and has a small disk, so the app never
// talks to Grafana Cloud directly. It emits to THIS process on localhost, which
// buffers to disk within a hard cap and forwards when there is a connection.
// The app therefore never blocks on telemetry, and holds no cloud credentials.
//
//   edge-node (Go)  --OTLP/gRPC 4317--> [receiver] --> [filter] -----\
//                   --OTLP/HTTP  4318-->                              \
//   edge-node :9090/metrics  <--scrape-- [prometheus] --> [identity] --+--> [batch]
//                                                                          |
//                              disk buffer (capped) <--> [otlphttp] <------/
//                                                            |
//                                      https://<cloud>/api/telemetry  (X-Node-Key)
//
// Everything is configured through environment variables set per box by
// scripts\install.ps1 from env\alloy.env -- see env\alloy.env.example for the
// full list and the defaults below for what happens when one is unset.
//
// Validate after editing:
//   artifacts\alloy\alloy.exe validate --stability.level=public-preview alloy\config.alloy
//
// NOTE: otelcol.storage.file (the disk buffer) is public-preview, which is why
// the service runs with --stability.level=public-preview. Without that flag
// Alloy refuses to start, so do not drop it from services\alloy.xml.

logging {
	// Alloy's OWN logs stay on the box (WinSW captures stdout). They are not
	// forwarded: a cloud outage would otherwise make Alloy log about failing to
	// ship logs, and buffer that.
	level  = coalesce(sys.env("LAGUNA_ALLOY_LOG_LEVEL"), "warn")
	format = "logfmt"
}

// --- Credentials -------------------------------------------------------------

// The node key is read from a file rather than an environment variable so it is
// not readable from every other process's environment on the box, and never
// lands in a committed service XML. install.ps1 writes it from env\alloy.env and
// locks it down with icacls.
local.file "node_key" {
	filename  = coalesce(sys.env("LAGUNA_NODE_KEY_FILE"), "C:\\laguna-edge\\env\\alloy-node-key")
	is_secret = true
}

otelcol.auth.headers "cloud" {
	// Same credential the data-sync path uses; the cloud ingest matches it against
	// its NODE_SYNC_KEY and only then relays to Grafana Cloud.
	header {
		key   = "X-Node-Key"
		value = local.file.node_key.content
	}
}

// --- Ingress: the app's logs and traces ---------------------------------------

otelcol.receiver.otlp "edge" {
	// localhost only. Nothing but the app may reach these ports, and the hop is
	// always up even when the box is offline -- that is what keeps the POS from
	// ever blocking on telemetry.
	grpc {
		endpoint = coalesce(sys.env("LAGUNA_OTLP_GRPC_ADDRESS"), "127.0.0.1:4317")
	}

	http {
		endpoint = coalesce(sys.env("LAGUNA_OTLP_HTTP_ADDRESS"), "127.0.0.1:4318")
	}

	output {
		logs   = [otelcol.processor.filter.log_severity.input]
		traces = [otelcol.processor.batch.cloud.input]
	}
}

// Volume lever: drop anything below the configured severity before it can reach
// the disk buffer. Records with no severity set are kept -- an unlabelled log is
// more likely a gap in instrumentation than noise worth discarding.
otelcol.processor.filter "log_severity" {
	error_mode = "ignore"

	logs {
		log_record = [
			"severity_number != SEVERITY_NUMBER_UNSPECIFIED and severity_number < SEVERITY_NUMBER_" + coalesce(sys.env("LAGUNA_MIN_LOG_SEVERITY"), "INFO"),
		]
	}

	output {
		logs = [otelcol.processor.batch.cloud.input]
	}
}

// --- Ingress: the app's metrics -----------------------------------------------

prometheus.scrape "edge_node" {
	targets = [{
		__address__ = coalesce(sys.env("LAGUNA_METRICS_ADDRESS"), "127.0.0.1:9090"),
	}]

	job_name        = coalesce(sys.env("LAGUNA_SERVICE_NAME"), "laguna-backend")
	metrics_path    = "/metrics"
	scrape_interval = coalesce(sys.env("LAGUNA_METRICS_SCRAPE_INTERVAL"), "60s")
	scrape_timeout = coalesce(sys.env("LAGUNA_METRICS_SCRAPE_TIMEOUT"), "10s")
	forward_to     = [otelcol.receiver.prometheus.edge_node.receiver]
}

// One protocol edge->cloud: scraped Prometheus metrics become OTLP so logs,
// traces, and metrics share a single authenticated channel and a single buffer.
otelcol.receiver.prometheus "edge_node" {
	output {
		metrics = [otelcol.processor.transform.metric_identity.input]
	}
}

// Metrics are collected here, not emitted by the app, so their identity is
// stamped here -- with the same values and the same attribute names the app puts
// on its own OTel resource, so a node id filter returns all three signal types.
otelcol.processor.transform "metric_identity" {
	error_mode = "ignore"

	metric_statements {
		context = "resource"

		statements = [
			`set(attributes["service.name"], "` + coalesce(sys.env("LAGUNA_SERVICE_NAME"), "laguna-backend") + `")`,
			`set(attributes["service.instance.id"], "` + sys.env("LAGUNA_NODE_ID") + `")`,
			`set(attributes["node.id"], "` + sys.env("LAGUNA_NODE_ID") + `")`,
			`set(attributes["organization.id"], "` + sys.env("LAGUNA_ORGANIZATION_ID") + `")`,
			`set(attributes["deployment.mode"], "` + coalesce(sys.env("LAGUNA_DEPLOYMENT_MODE"), "edge") + `")`,
			`set(attributes["deployment.environment.name"], "` + coalesce(sys.env("LAGUNA_ENVIRONMENT"), "production") + `")`,
		]
	}

	output {
		metrics = [otelcol.processor.batch.cloud.input]
	}
}

// --- Egress -------------------------------------------------------------------

otelcol.processor.batch "cloud" {
	// Batch on a long timeout: on a box that is mostly idle this trades a little
	// freshness for far fewer round trips and far fewer buffer entries.
	timeout             = coalesce(sys.env("LAGUNA_BATCH_TIMEOUT"), "10s")
	send_batch_size     = 2048
	send_batch_max_size = 4096

	output {
		logs    = [otelcol.exporter.otlphttp.cloud.input]
		metrics = [otelcol.exporter.otlphttp.cloud.input]
		traces  = [otelcol.exporter.otlphttp.cloud.input]
	}
}

// The disk buffer. bbolt file under LAGUNA_TELEMETRY_BUFFER_DIR; survives an
// Alloy restart, so a service restart mid-outage does not lose the backlog.
otelcol.storage.file "buffer" {
	directory        = coalesce(sys.env("LAGUNA_TELEMETRY_BUFFER_DIR"), "C:\\laguna-edge\\alloy-data\\buffer")
	create_directory = true

	// Reclaim space as the backlog drains, instead of leaving the file at its
	// high-water mark until the service restarts.
	compaction {
		on_start                      = true
		on_rebound                    = true
		directory                     = coalesce(sys.env("LAGUNA_TELEMETRY_BUFFER_DIR"), "C:\\laguna-edge\\alloy-data\\buffer")
		rebound_needed_threshold_mib  = 16
		rebound_trigger_threshold_mib = 8
	}
}

otelcol.exporter.otlphttp "cloud" {
	client {
		// The cloud relay, NOT Grafana Cloud. Base URL only -- the exporter appends
		// /v1/logs, /v1/traces, /v1/metrics, which is exactly how the ingest routes.
		endpoint    = sys.env("LAGUNA_TELEMETRY_INGEST_URL")
		auth        = otelcol.auth.headers.cloud.handler
		compression = "gzip"
		timeout     = "30s"
	}

	sending_queue {
		enabled = true
		storage = otelcol.storage.file.buffer.handler

		// Hard cap in BYTES, not in batches: the point of the cap is the box's disk.
		//
		// Budget disk as ~6x this number. The cap applies PER SIGNAL (one bbolt file
		// each for logs, traces, metrics) and bbolt allocates in doublings, so a 32 MiB
		// cap was measured holding a ~64 MiB file per signal.
		//
		// When full, Alloy REJECTS new telemetry and keeps what is already queued --
		// its persistent queue has no drop-oldest mode. A cap-filling outage therefore
		// keeps its beginning and loses its tail.
		sizer         = "bytes"
		queue_size    = coalesce(sys.env("LAGUNA_TELEMETRY_BUFFER_BYTES"), 33554432)
		num_consumers = 1
	}

	retry_on_failure {
		enabled          = true
		initial_interval = "5s"
		max_interval     = "5m"
		// Age-out: a batch that has been failing for longer than this is dropped so
		// the head of the queue cannot wedge behind one bad export. Set well above a
		// realistic outage so a normal offline period is delivered in full.
		max_elapsed_time = coalesce(sys.env("LAGUNA_TELEMETRY_MAX_RETRY_AGE"), "24h")
	}
}
