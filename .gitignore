# Fetched binaries & build bundles — never committed; pulled by scripts/fetch-artifacts.ps1
/artifacts/*
!/artifacts/.gitkeep

# WinSW wrapper copies created by scripts/install.ps1 (services/<name>.exe)
/services/*.exe

# Per-box service config with secrets (templates *.env.example are committed)
/env/*.env

# Runtime
/logs/
/caddy-data/

# Exported CA cert (regenerated per box)
/certs/*.crt
/certs/*.pem
/certs/*.der
!/certs/.gitkeep

# OS
.DS_Store
Thumbs.db
