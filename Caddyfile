# laguna-escondida-edge — LAN HTTPS reverse proxy for the restaurant edge box.
#
# Only THIS service is exposed on the LAN. Next.js, both Go services, and Postgres
# all bind 127.0.0.1 and are unreachable from the network.
#
# Install-root convention on the Windows box: C:\laguna-edge
# (the absolute path below must match where you deploy this repo).
{
	# Persist Caddy's data — INCLUDING the internal CA root cert — at a fixed path so
	# it survives restarts/reinstalls and provisioned tablets keep trusting HTTPS.
	# If this dir is ever lost, the root cert changes and every tablet must re-trust.
	storage file_system {
		root C:\laguna-edge\caddy-data
	}
}

# ── The POS site (IP-based, no local DNS required) ───────────────────────────────
# Tablets reach this directly at the box's reserved IP:  https://192.168.101.49
# Caddy's internal CA issues a cert with the IP in the SAN. Pin this IP with a DHCP
# reservation on the router (bind the box MAC -> 192.168.101.49) so it never changes.
# Caddy also listens on :80 and redirects to :443 automatically.
#
# When you add dedicated DNS hardware later, add a second site address for the
# hostname (e.g. `pos.laguna.lan, 192.168.101.49 { ... }`) — they coexist.
192.168.101.49 {
	tls internal # Caddy's own internal CA — no public domain / no ACME

	encode zstd gzip

	# Defense-in-depth. The Windows Firewall rule (scripts/install.ps1) is the PRIMARY
	# control; this rejects anything not on the POS subnet at the app layer too.
	# Keep the CIDR in sync with the firewall rule and your DHCP scope.
	@notlan not remote_ip 192.168.101.0/24
	respond @notlan "Forbidden" 403

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Proxy to the Next.js standalone server (bound to localhost).
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1 # stream SSE immediately, no buffering
	}
}
