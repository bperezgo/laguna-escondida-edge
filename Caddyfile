# laguna-escondida-edge — LAN HTTPS reverse proxy for the restaurant edge box.
#
# Only THIS service is exposed on the LAN. Next.js, both Go services, and Postgres
# all bind 127.0.0.1 and are unreachable from the network.
#
# Install-root convention on the Windows box: C:\laguna-edge
# (the absolute path below must match where you deploy this repo).
{
	# Persist Caddy's data — INCLUDING the internal CA root cert — at a fixed path so
	# it survives restarts/reinstalls and provisioned tablets keep trusting HTTPS.
	# If this dir is ever lost, the root cert changes and every tablet must re-trust.
	storage file_system {
		root C:\laguna-edge\caddy-data
	}
}

# ── The POS site (IP-based, no local DNS required) ───────────────────────────────
# The IP and subnet below are PLACEHOLDERS resolved at service start from machine env
# vars that scripts\install.ps1 exports from env\box.env (the single source of truth):
#   {$LAGUNA_LAN_IP}   -> e.g. 192.168.0.123   (this box's reserved IP)
#   {$LAGUNA_LAN_CIDR} -> e.g. 192.168.0.0/24  (the POS subnet)
# To change the network, edit env\box.env and re-run install.ps1 — do NOT hardcode IPs here.
#
# Tablets reach this directly at https://<LAGUNA_LAN_IP>. Caddy's internal CA issues a cert
# with that IP in the SAN. Pin the IP with a router DHCP reservation so it never changes.
# Caddy also listens on :80 and redirects to :443 automatically.
#
# When you add dedicated DNS hardware later, add a second site address for the
# hostname (e.g. `pos.laguna.lan, {$LAGUNA_LAN_IP} { ... }`) — they coexist.
{$LAGUNA_LAN_IP} {
	tls internal # Caddy's own internal CA — no public domain / no ACME

	encode zstd gzip

	# Defense-in-depth. The Windows Firewall rule (scripts/install.ps1) is the PRIMARY
	# control; this rejects anything not on the POS subnet at the app layer too.
	# Same CIDR as the firewall rule — both come from LAGUNA_LAN_CIDR in env\box.env.
	@notlan not remote_ip {$LAGUNA_LAN_CIDR}
	respond @notlan "Forbidden" 403

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Proxy to the Next.js standalone server (bound to localhost).
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1 # stream SSE immediately, no buffering

		# Next's middleware (frontend proxy.ts) builds redirects with
		# `new URL("/signin", request.url)`. In standalone mode Next derives that URL's
		# HOST from its own bind origin (localhost:3000), NOT the public Host header — so
		# the browser gets `Location: https://localhost:3000/signin` and fails (there is no
		# HTTPS server on :3000; on a tablet localhost is the tablet itself). Strip the bogus
		# absolute origin so the Location becomes RELATIVE (/signin); the browser then resolves
		# it against the real host it used (https://<LAGUNA_LAN_IP>). IP-independent, covers all
		# server-side redirects. PORT is 3000 on every box, so this match is stable.
		header_down Location "https?://localhost:3000" ""
	}
}
